---
import { getStrings, localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getStrings(locale);
const homePath = localePath(locale, '/');
---

<section class="hero">
  <div class="container hero-inner">
    <span class="eyebrow">{t.hero.badge}</span>
    <h1>{t.about.heading}</h1>
    <p class="hero-lead">{t.about.lead}</p>
  </div>
</section>

<section class="section" aria-labelledby="story-heading">
  <div class="container">
    <div class="section-head">
      <h2 id="story-heading">{t.about.s1Title}</h2>
      <p>{t.about.s1Body}</p>
    </div>
    <div class="grid grid-3">
      <article class="card">
        <span class="step-num" aria-hidden="true">1</span>
        <h3>{t.about.s2Title}</h3>
        <p>{t.about.s2Body}</p>
      </article>
      <article class="card">
        <span class="step-num" aria-hidden="true">2</span>
        <h3>{t.about.s3Title}</h3>
        <p>{t.about.s3Body}</p>
      </article>
    </div>
  </div>
</section>

<section class="section section-soft" aria-labelledby="values-heading">
  <div class="container">
    <div class="section-head">
      <h2 id="values-heading">{t.about.valuesHeading}</h2>
    </div>
    <div class="value-list" style="max-width: 720px; margin: 0 auto;">
      <div class="value-item">
        <span class="icon-bubble" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3Z" /><path d="m9 12 2 2 4-4" /></svg>
        </span>
        <div>
          <h3>{t.about.v1Title}</h3>
          <p>{t.about.v1Body}</p>
        </div>
      </div>
      <div class="value-item">
        <span class="icon-bubble" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9" /><path d="M12 7v5l3 3" /></svg>
        </span>
        <div>
          <h3>{t.about.v2Title}</h3>
          <p>{t.about.v2Body}</p>
        </div>
      </div>
      <div class="value-item">
        <span class="icon-bubble" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2" /><circle cx="10" cy="7" r="4" /><path d="M21 21v-2a4 4 0 0 0-3-3.87" /></svg>
        </span>
        <div>
          <h3>{t.about.v3Title}</h3>
          <p>{t.about.v3Body}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="cta-card">
      <h2>{t.about.ctaTitle}</h2>
      <p>{t.about.ctaBody}</p>
      <a class="btn btn-on-dark btn-lg" href={`${homePath}#get-app`}>{t.about.ctaLabel}</a>
    </div>
  </div>
</section>
