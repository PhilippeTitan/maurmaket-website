---
import { getStrings, localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getStrings(locale);
const homePath = localePath(locale, '/');
---

<section class="hero hero-page">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-copy">
      <p class="badge"><i class="flag" aria-hidden="true"></i>{t.hero.badge}</p>
      <h1>{t.about.heading}</h1>
      <p class="hero-lead">{t.about.lead}</p>
    </div>
  </div>
</section>

<section class="band cv" aria-labelledby="story-heading">
  <div class="container split">
    <div class="split-head">
      <h2 id="story-heading">{t.about.s1Title}</h2>
      <p class="split-sub">{t.about.s1Body}</p>
    </div>
    <div class="promises">
      <div class="promise">
        <h3>{t.about.s2Title}</h3>
        <p>{t.about.s2Body}</p>
      </div>
      <div class="promise">
        <h3>{t.about.s3Title}</h3>
        <p>{t.about.s3Body}</p>
      </div>
    </div>
  </div>
</section>

<section class="band band-fade cv" aria-labelledby="values-heading">
  <div class="container split">
    <div class="split-head">
      <h2 id="values-heading">{t.about.valuesHeading}</h2>
    </div>
    <div class="promises">
      <div class="promise">
        <h3>{t.about.v1Title}</h3>
        <p>{t.about.v1Body}</p>
      </div>
      <div class="promise">
        <h3>{t.about.v2Title}</h3>
        <p>{t.about.v2Body}</p>
      </div>
      <div class="promise">
        <h3>{t.about.v3Title}</h3>
        <p>{t.about.v3Body}</p>
      </div>
    </div>
  </div>
</section>

<section class="download download-cta cv" aria-labelledby="about-cta-heading">
  <img class="download-art" src="/brand-icon-512.webp" alt="" width="512" height="473" loading="lazy" decoding="async" />
  <div class="container download-inner">
    <h2 id="about-cta-heading">{t.about.ctaTitle}</h2>
    <p class="download-sub">{t.about.ctaBody}</p>
    <a class="btn btn-primary btn-lg" href={`${homePath}#get-app`}>{t.about.ctaLabel}</a>
  </div>
</section>
